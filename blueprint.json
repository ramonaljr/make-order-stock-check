{
  "name": "Order Stock Check",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "from": "share",
        "limit": 10,
        "filter": [
          [
            {
              "a": "G",
              "b": "New",
              "o": "text:equal:ci"
            }
          ]
        ],
        "sheetId": "Untitled",
        "spreadsheetId": "YOUR_ORDERS_SHEET_ID",
        "tableFirstRow": "A1:Z1",
        "includesHeaders": true
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Get new orders"
        }
      }
    },
    {
      "id": 2,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "from": "share",
        "limit": 1,
        "filter": [
          [
            {
              "a": "A",
              "b": "{{1.`4`}}",
              "o": "text:equal:ci"
            }
          ]
        ],
        "sheetId": "Untitled",
        "spreadsheetId": "YOUR_INVENTORY_SHEET_ID",
        "tableFirstRow": "A1:Z1",
        "includesHeaders": true
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Look up stock"
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": null
              },
              "filter": {
                "name": "Enough stock",
                "conditions": [
                  [
                    {
                      "a": "{{1.`5`}}",
                      "b": "{{2.`2`}}",
                      "o": "number:lessorequal"
                    }
                  ]
                ]
              },
              "mapper": {
                "mode": "fromAll",
                "values": {
                  "2": "{{2.`2` - 1.`5`}}"
                },
                "sheetId": "Untitled",
                "rowNumber": "{{2.`__ROW_NUMBER__`}}",
                "spreadsheetId": "YOUR_INVENTORY_SHEET_ID",
                "includesHeaders": true,
                "useColumnHeaders": false,
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -300,
                  "name": "Reserve stock"
                }
              }
            },
            {
              "id": 5,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "mode": "fromAll",
                "values": {
                  "6": "Confirmed",
                  "7": "Reserved {{1.`5`}}; {{2.`2` - 1.`5`}} left in stock",
                  "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}"
                },
                "sheetId": "Untitled",
                "rowNumber": "{{1.`__ROW_NUMBER__`}}",
                "spreadsheetId": "YOUR_ORDERS_SHEET_ID",
                "includesHeaders": true,
                "useColumnHeaders": false,
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": -300,
                  "name": "Mark order confirmed"
                }
              }
            },
            {
              "id": 6,
              "module": "google-email:sendAnEmail",
              "version": 4,
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "to": [
                  "{{1.`3`}}"
                ],
                "subject": "Order {{1.`0`}} confirmed",
                "bodyType": "collection",
                "contents": [
                  {
                    "text": "Hi {{1.`2`}},\n\nGood news: your order {{1.`0`}} for {{1.`5`}} x {{2.`1`}} is confirmed, and the items are reserved for you. We'll email you again when it ships.\n\nThanks for your order,\nThe Shop Team",
                    "image": {}
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -300,
                  "name": "Email order confirmation"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "slack:CreateMessage",
              "version": 4,
              "parameters": {
                "__IMTCONN__": null
              },
              "filter": {
                "name": "Stock falls below reorder level",
                "conditions": [
                  [
                    {
                      "a": "{{1.`5`}}",
                      "b": "{{2.`2`}}",
                      "o": "number:lessorequal"
                    },
                    {
                      "a": "{{2.`2` - 1.`5`}}",
                      "b": "{{2.`3`}}",
                      "o": "number:less"
                    }
                  ]
                ]
              },
              "mapper": {
                "text": ":warning: Low stock: {{2.`1`}} ({{2.`0`}}) is down to {{2.`2` - 1.`5`}} after order {{1.`0`}}. The reorder level is {{2.`3`}}, so please place a restock order.",
                "parse": false,
                "mrkdwn": true,
                "channel": "YOUR_SLACK_CHANNEL_ID",
                "channelType": "public",
                "channelWType": "list"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 0,
                  "name": "Alert operations: low stock"
                },
                "setupValidation": {
                  "result": {
                    "valid": true,
                    "fields": []
                  },
                  "version": 1,
                  "configuration": "d85acd3278dd8be0"
                },
                "restore": {
                  "expect": {
                    "parse": {
                      "mode": "chose"
                    },
                    "mrkdwn": {
                      "mode": "chose"
                    },
                    "channel": {
                      "mode": "chose",
                      "label": "operations"
                    },
                    "link_names": {
                      "mode": "chose"
                    },
                    "channelType": {
                      "label": "Public channel"
                    },
                    "channelWType": {
                      "label": "Select from the list"
                    },
                    "unfurl_links": {
                      "mode": "chose"
                    },
                    "unfurl_media": {
                      "mode": "chose"
                    },
                    "reply_broadcast": {
                      "mode": "chose"
                    }
                  },
                  "parameters": {
                    "__IMTCONN__": {
                      "data": {
                        "scoped": "true",
                        "connection": "slack3"
                      },
                      "label": "Your connection"
                    }
                  }
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account:slack2,slack3",
                    "label": "Connection",
                    "required": true
                  }
                ],
                "expect": [
                  {
                    "name": "channelWType",
                    "type": "select",
                    "label": "Enter a channel ID or name",
                    "required": true,
                    "validate": {
                      "enum": [
                        "manualy",
                        "list"
                      ]
                    }
                  },
                  {
                    "name": "text",
                    "type": "text",
                    "label": "Text"
                  },
                  {
                    "name": "blocks",
                    "type": "text",
                    "label": "Blocks"
                  },
                  {
                    "name": "thread_ts",
                    "type": "text",
                    "label": "Thread message ID (time stamp)"
                  },
                  {
                    "name": "reply_broadcast",
                    "type": "boolean",
                    "label": "Reply broadcast"
                  },
                  {
                    "name": "link_names",
                    "type": "boolean",
                    "label": "Link names"
                  },
                  {
                    "name": "parse",
                    "type": "boolean",
                    "label": "Parse message text"
                  },
                  {
                    "name": "mrkdwn",
                    "type": "boolean",
                    "label": "Use markdown"
                  },
                  {
                    "name": "unfurl_links",
                    "type": "boolean",
                    "label": "Unfurl primarily text-based content"
                  },
                  {
                    "name": "unfurl_media",
                    "type": "boolean",
                    "label": "Unfurl media content"
                  },
                  {
                    "name": "icon_emoji",
                    "type": "text",
                    "label": "Icon emoji"
                  },
                  {
                    "name": "icon_url",
                    "type": "url",
                    "label": "Icon url"
                  },
                  {
                    "name": "username",
                    "type": "text",
                    "label": "User name"
                  },
                  {
                    "name": "channelType",
                    "type": "select",
                    "label": "Channel type",
                    "required": true,
                    "validate": {
                      "enum": [
                        "public",
                        "private",
                        "im",
                        "mpim"
                      ]
                    }
                  },
                  {
                    "name": "channel",
                    "type": "select",
                    "label": "Public channel",
                    "required": true
                  }
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 8,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": null
              },
              "filter": {
                "name": "Not enough stock",
                "conditions": [
                  [
                    {
                      "a": "{{1.`5`}}",
                      "b": "{{2.`2`}}",
                      "o": "number:greater"
                    }
                  ]
                ]
              },
              "mapper": {
                "mode": "fromAll",
                "values": {
                  "6": "On hold",
                  "7": "Not enough stock: {{1.`5`}} ordered, {{2.`2`}} available",
                  "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}"
                },
                "sheetId": "Untitled",
                "rowNumber": "{{1.`__ROW_NUMBER__`}}",
                "spreadsheetId": "YOUR_ORDERS_SHEET_ID",
                "includesHeaders": true,
                "useColumnHeaders": false,
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 300,
                  "name": "Put order on hold"
                }
              }
            },
            {
              "id": 9,
              "module": "google-email:sendAnEmail",
              "version": 4,
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "to": [
                  "{{1.`3`}}"
                ],
                "subject": "An update on your order {{1.`0`}}",
                "bodyType": "collection",
                "contents": [
                  {
                    "text": "Hi {{1.`2`}},\n\nThanks for your order {{1.`0`}}. We don't have enough {{2.`1`}} in stock to fill it right now, so we've put it on hold rather than leave you waiting without word.\n\nSomeone from our team will email you within one business day with a restock date or an alternative.\n\nSorry for the wait,\nThe Shop Team",
                    "image": {}
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": 300,
                  "name": "Email customer about the delay"
                }
              }
            },
            {
              "id": 10,
              "module": "slack:CreateMessage",
              "version": 4,
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "text": ":no_entry: Order {{1.`0`}} is on hold. {{1.`2`}} ordered {{1.`5`}} x {{2.`1`}}, but only {{2.`2`}} are in stock. The customer has been told to expect an update within one business day.",
                "channel": "#operations",
                "channelWType": "manualy"
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 300,
                  "name": "Alert operations: order on hold"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com",
    "notes": []
  }
}
